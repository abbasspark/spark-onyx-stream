//
// Spark Onyx Stream - database schema
// Phase 1: media engine core and admin access.
// Phase 2: catalog (titles, seasons, episodes, categories, artwork).
// Viewer and billing models are added in later phases.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin access
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model AdminUser {
  recordings   Recording[]
  id           String      @id @default(uuid(7)) @db.Uuid
  email        String      @unique
  passwordHash String
  displayName  String
  role         AdminRole   @default(EDITOR)
  totpSecret   String?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions             AdminSession[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  assets               Asset[]
  subscriptionsGranted Subscription[]
  paymentsRecorded     Payment[]
  purchasesGranted     Purchase[]
  backups              Backup[]
  translationJobs      TranslationJob[]

  @@map("admin_users")
}

/// A signed-in admin session. The token is shown to the client once at login;
/// only its hash is stored, so a database leak does not expose usable tokens.
model AdminSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  adminId    String    @db.Uuid
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the session token.
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

enum ViewerStatus {
  ACTIVE
  /// Cannot sign in. Existing sessions stop working at once.
  DISABLED
}

/// A person who watches: an account on the viewer website and in the apps.
/// Kept apart from admins on purpose. A viewer can never reach the panel.
model Viewer {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// Lower case. The sign-in name.
  email            String       @unique
  passwordHash     String
  displayName      String
  status           ViewerStatus @default(ACTIVE)
  /// When the viewer showed that the email address is theirs, or an admin vouched for it.
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  /// The viewer as a customer at Stripe, once they started a checkout.
  stripeCustomerId String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sessions      ViewerSession[]
  profiles      ViewerProfile[]
  subscriptions Subscription[]
  payments      Payment[]
  purchases     Purchase[]
  watching      WatchProgress[]
  saved         WatchlistItem[]
  plays         Play[]
  tokens        ViewerToken[]

  @@index([createdAt])
  @@map("viewers")
}

/// A device a viewer is signed in on. As with admins, only a hash of the
/// token is stored.
model ViewerSession {
  id         String         @id @default(uuid(7)) @db.Uuid
  viewerId   String         @db.Uuid
  viewer     Viewer         @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  /// The profile chosen on this device. Empty means the main profile.
  profileId  String?        @db.Uuid
  profile    ViewerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  /// SHA-256 hash of the session token.
  tokenHash  String         @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime       @default(now())
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@index([viewerId])
  @@index([expiresAt])
  @@map("viewer_sessions")
}

model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  /// First characters of the key, shown in the panel so a key can be recognized.
  prefix      String    @unique
  /// SHA-256 hash of the full key. The key itself is shown once and never stored.
  keyHash     String    @unique
  scopes      String[]
  createdById String    @db.Uuid
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
  @@map("api_keys")
}

model AuditLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  adminId    String?    @db.Uuid
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime   @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------

enum StorageDriver {
  LOCAL
  S3
}

model StoragePool {
  id         String        @id @default(uuid(7)) @db.Uuid
  name       String        @unique
  driver     StorageDriver
  /// Driver settings: base path for LOCAL; endpoint, bucket and region for S3.
  /// Credentials are stored encrypted.
  config     Json
  isDefault  Boolean       @default(false)
  isActive   Boolean       @default(true)
  /// Optional limit in bytes. Null means unlimited.
  quotaBytes BigInt?
  usedBytes  BigInt        @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  assets         Asset[]
  images         Image[]
  backups        Backup[]
  watchLocations WatchLocation[]

  @@map("storage_pools")
}

// ---------------------------------------------------------------------------
// Watched locations
// ---------------------------------------------------------------------------

/// What happens to a file of a watched location once it is imported.
enum WatchAfterImport {
  /// Moved into the folder "imported" of the location.
  MOVE
  /// Left where it is.
  KEEP
  /// Deleted.
  DELETE
}

/// A folder or a bucket that is looked through for new videos, which are
/// imported by the name of their file: "603_the-matrix.mkv" is the movie 603
/// of TMDB, "1399_S01E05_x.mkv" an episode of the series 1399.
model WatchLocation {
  id       String        @id @default(uuid(7)) @db.Uuid
  name     String        @unique
  driver   StorageDriver
  /// As for a storage pool: a base path, or the settings of a bucket with
  /// its credentials encrypted.
  config   Json
  isActive Boolean       @default(true)

  /// How often the location is looked through.
  scanIntervalMinutes Int @default(5)

  /// Where imported videos are stored. Empty: the default pool.
  storagePoolId     String?          @db.Uuid
  storagePool       StoragePool?     @relation(fields: [storagePoolId], references: [id], onDelete: SetNull)
  processingMode    ProcessingMode?
  encodingProfileId String?          @db.Uuid
  encodingProfile   EncodingProfile? @relation(fields: [encodingProfileId], references: [id], onDelete: SetNull)

  /// Publishes what was imported as soon as its video plays. Off, imports stay drafts.
  autoPublish Boolean          @default(false)
  afterImport WatchAfterImport @default(MOVE)

  lastScanAt      DateTime?
  /// Why the last look failed, in words for an admin. Empty when it went well.
  lastScanError   String?
  /// Set when an admin asks for a look now.
  scanRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files WatchedFile[]

  @@map("watch_locations")
}

enum WatchedFileState {
  /// Seen, and still growing or too fresh to be touched.
  WAITING
  /// Its name does not say what it is. An admin has to.
  UNRECOGNISED
  /// Known what it is, waiting for its turn.
  QUEUED
  IMPORTING
  IMPORTED
  /// The title or episode has a video already. An admin decides.
  CONFLICT
  FAILED
  /// Set aside by an admin.
  IGNORED
}

/// One video file found in a watched location, and what became of it.
model WatchedFile {
  id         String           @id @default(uuid(7)) @db.Uuid
  locationId String           @db.Uuid
  location   WatchLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Path inside the location, with forward slashes.
  path       String
  size       BigInt
  modifiedAt DateTime
  state      WatchedFileState @default(WAITING)

  /// What the file is, from its name or from an admin: "movie:603" or "tv:1399".
  metadataId    String?
  seasonNumber  Int?
  episodeNumber Int?
  /// Whether an admin said what it is.
  matchedByHand Boolean @default(false)
  /// The video of the title or episode may be replaced by this file.
  replace       Boolean @default(false)

  titleId   String?  @db.Uuid
  title     Title?   @relation(fields: [titleId], references: [id], onDelete: SetNull)
  episodeId String?  @db.Uuid
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  assetId   String?  @db.Uuid
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// Still to be published once its video plays.
  publishPending Boolean @default(false)
  /// Why it failed or waits for an admin, in words.
  note           String?

  firstSeenAt DateTime  @default(now())
  importedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([locationId, path])
  @@index([state])
  @@index([locationId, state])
  @@map("watched_files")
}

// ---------------------------------------------------------------------------
// Assets (VOD)
// ---------------------------------------------------------------------------

enum AssetStatus {
  /// Record created, upload not finished.
  UPLOADING
  /// Source file complete, waiting for probe.
  UPLOADED
  /// Being probed, transcoded or packaged.
  PROCESSING
  /// Playable.
  READY
  /// Processing failed. See the failed job for the reason.
  FAILED
  /// Soft-deleted. Files are removed by a cleanup job.
  DELETED
}

enum ProcessingMode {
  /// Remux only: the source codecs are kept and only the container changes.
  COPY
  /// Re-encode into the renditions of an encoding profile.
  TRANSCODE
  /// Serve the original file unchanged.
  PASSTHROUGH
}

enum EncryptionMode {
  NONE
  AES_128
}

model Asset {
  /// The recording this asset was made from, if any.
  recording Recording?
  id        String      @id @default(uuid(7)) @db.Uuid
  title     String
  status    AssetStatus @default(UPLOADING)

  storagePoolId String      @db.Uuid
  storagePool   StoragePool @relation(fields: [storagePoolId], references: [id])

  createdById String?    @db.Uuid
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Source file
  sourceFilename String?
  /// Path of the source file, relative to the storage pool root.
  sourcePath     String?
  sourceBytes    BigInt?
  sourceChecksum String?
  /// Raw ffprobe output of the source file.
  probe          Json?

  // Summary of the source, filled in after probing
  durationMs Int?
  width      Int?
  height     Int?
  frameRate  Float?
  videoCodec String?
  audioCodec String?

  // Processing
  /// Chosen by the decision engine after probing. May be forced at upload time.
  processingMode    ProcessingMode?
  encodingProfileId String?          @db.Uuid
  encodingProfile   EncodingProfile? @relation(fields: [encodingProfileId], references: [id], onDelete: SetNull)

  // Output
  /// Path of the HLS multivariant playlist, relative to the storage pool root.
  manifestPath String?
  encryption   EncryptionMode @default(NONE)
  p2pEnabled   Boolean        @default(true)

  readyAt   DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  renditions     Rendition[]
  audioTracks    AudioTrack[]
  subtitleTracks SubtitleTrack[]
  thumbnails     Thumbnail[]
  encryptionKeys EncryptionKey[]
  jobs           Job[]

  // Catalog entries that play this asset. The asset itself does not depend on them.
  titles        Title[]       @relation("TitleMainAsset")
  trailerTitles Title[]       @relation("TitleTrailerAsset")
  extras        TitleExtra[]
  episodes      Episode[]
  watchedFiles  WatchedFile[]

  @@index([status])
  @@index([storagePoolId])
  @@index([createdAt])
  @@map("assets")
}

model Rendition {
  id           String   @id @default(uuid(7)) @db.Uuid
  assetId      String   @db.Uuid
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Label shown in the player, for example "1080p".
  name         String
  width        Int
  height       Int
  /// Average video bitrate in bits per second.
  bitrate      Int
  frameRate    Float?
  codec        String
  /// Path of the media playlist, relative to the storage pool root.
  playlistPath String
  sizeBytes    BigInt   @default(0)
  createdAt    DateTime @default(now())

  @@unique([assetId, name])
  @@map("renditions")
}

model AudioTrack {
  id           String   @id @default(uuid(7)) @db.Uuid
  assetId      String   @db.Uuid
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// BCP 47 language tag, for example "en" or "de".
  language     String
  label        String?
  codec        String
  channels     Int
  bitrate      Int
  isDefault    Boolean  @default(false)
  playlistPath String
  createdAt    DateTime @default(now())

  @@index([assetId])
  @@map("audio_tracks")
}

enum SubtitleSource {
  /// Extracted from the source file.
  EMBEDDED
  /// Uploaded separately.
  UPLOADED
}

model SubtitleTrack {
  id        String         @id @default(uuid(7)) @db.Uuid
  assetId   String         @db.Uuid
  asset     Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  language  String
  label     String?
  source    SubtitleSource
  isDefault Boolean        @default(false)
  isForced  Boolean        @default(false)
  /// Path of the WebVTT file, relative to the storage pool root.
  path      String
  createdAt DateTime       @default(now())

  @@index([assetId])
  @@map("subtitle_tracks")
}

enum ThumbnailType {
  /// Single poster image.
  POSTER
  /// Sprite sheet for seek-bar previews.
  SPRITE
  /// WebVTT file that maps time ranges to sprite positions.
  SPRITE_VTT
}

model Thumbnail {
  id        String        @id @default(uuid(7)) @db.Uuid
  assetId   String        @db.Uuid
  asset     Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      ThumbnailType
  path      String
  width     Int?
  height    Int?
  createdAt DateTime      @default(now())

  @@index([assetId])
  @@map("thumbnails")
}

model EncryptionKey {
  id           String    @id @default(uuid(7)) @db.Uuid
  assetId      String    @db.Uuid
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Content key, encrypted with the platform master key. Never stored in plain form.
  encryptedKey Bytes
  iv           Bytes
  /// Rotation counter. The highest active version is used for new packaging.
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  retiredAt    DateTime?

  @@unique([assetId, version])
  @@map("encryption_keys")
}

// ---------------------------------------------------------------------------
// Encoding profiles
// ---------------------------------------------------------------------------

model EncodingProfile {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @unique
  description     String?
  isDefault       Boolean  @default(false)
  /// Segment length in seconds. All renditions share it so they stay aligned.
  segmentSeconds  Int      @default(4)
  /// Keyframe interval in seconds. Must divide segmentSeconds evenly.
  keyframeSeconds Int      @default(2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  renditions     EncodingProfileRendition[]
  watchLocations WatchLocation[]
  assets         Asset[]

  @@map("encoding_profiles")
}

model EncodingProfileRendition {
  id           String          @id @default(uuid(7)) @db.Uuid
  profileId    String          @db.Uuid
  profile      EncodingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  /// Target height in pixels. Width follows the source aspect ratio.
  /// Renditions taller than the source are skipped, so nothing is upscaled.
  height       Int
  videoBitrate Int
  audioBitrate Int
  videoCodec   String          @default("h264")
  audioCodec   String          @default("aac")
  /// Encoder preset, for example "medium" or "slow".
  preset       String          @default("medium")
  sortOrder    Int             @default(0)

  @@unique([profileId, name])
  @@map("encoding_profile_renditions")
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

enum JobType {
  PROBE
  REMUX
  TRANSCODE
  PACKAGE
  THUMBNAILS
  SUBTITLES
  CLEANUP
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Durable record of processing work. BullMQ in Redis drives execution;
/// this table keeps the history, so job state survives a Redis restart
/// and can be shown in the panel.
model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  type        JobType
  status      JobStatus @default(QUEUED)
  assetId     String?   @db.Uuid
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Higher numbers run first.
  priority    Int       @default(0)
  /// Progress from 0 to 100.
  progress    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  input       Json?
  output      Json?
  error       String?
  /// Identifier of the worker process that ran the job.
  workerId    String?
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([assetId])
  @@index([status, type])
  @@index([queuedAt])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Catalog (OTT layer)
//
// What viewers browse. A title or an episode points to an asset of the media
// engine. Assets know nothing about the catalog.
// ---------------------------------------------------------------------------

enum TitleType {
  MOVIE
  SERIES
}

enum SeriesStatus {
  /// Announced, with nothing shown yet.
  UPCOMING
  /// More episodes are to come.
  RUNNING
  /// The story is told. No more episodes.
  ENDED
  /// Stopped before its end.
  CANCELLED
}

enum PublishStatus {
  /// Being prepared. Only admins see it.
  DRAFT
  /// Visible to viewers.
  PUBLISHED
  /// Taken out of the catalog but kept.
  ARCHIVED
}

enum ImageKind {
  /// Upright picture for lists and cards, usually 2:3.
  POSTER
  /// Wide picture behind the title page, usually 16:9.
  BACKDROP
  /// Wide picture of one episode.
  STILL
  /// The title as a transparent logo.
  LOGO
  /// A picture of a person.
  PORTRAIT
}

/// A picture uploaded for the catalog. Served without a token, because
/// artwork of published titles is public by nature.
model Image {
  id            String      @id @default(uuid(7)) @db.Uuid
  kind          ImageKind
  storagePoolId String      @db.Uuid
  storagePool   StoragePool @relation(fields: [storagePoolId], references: [id])
  /// Path of the file, relative to the storage pool root.
  path          String
  /// "image/jpeg", "image/png" or "image/webp".
  mimeType      String
  width         Int
  height        Int
  bytes         Int
  createdById   String?     @db.Uuid
  createdAt     DateTime    @default(now())

  posterOf             Title[]      @relation("TitlePoster")
  backdropOf           Title[]      @relation("TitleBackdrop")
  logoOf               Title[]      @relation("TitleLogo")
  stillOf              Episode[]
  seasonPosterOf       Season[]
  portraitOf           Person[]
  collectionPosterOf   Collection[] @relation("CollectionPoster")
  collectionBackdropOf Collection[] @relation("CollectionBackdrop")

  @@map("images")
}

/// A movie or a series as viewers see it.
model Title {
  id               String        @id @default(uuid(7)) @db.Uuid
  type             TitleType
  /// Part of the web address, for example "the-long-road". Unique.
  slug             String        @unique
  name             String
  originalName     String?
  tagline          String?
  synopsis         String?
  releaseYear      Int?
  /// Age rating as shown to viewers, for example "12" or "PG-13".
  ageRating        String?
  /// Language code of the original audio, for example "en".
  originalLanguage String?
  /// The day of the premiere: in cinemas for a movie, the first episode for a series.
  releaseDate      DateTime?     @db.Date
  /// Movies: the length of the film. Series: the usual length of an episode. In minutes.
  runtimeMinutes   Int?
  /// Where it was made, as ISO 3166 codes such as "US".
  countries        String[]      @default([])
  /// The companies that made it.
  studios          String[]      @default([])
  /// Words it can be found by, beyond its name and genres.
  keywords         String[]      @default([])
  /// The id at IMDb, such as "tt0133093".
  imdbId           String?
  /// What the audience of the metadata source thinks of it, from 0 to 10, and how many voted.
  rating           Float?
  ratingCount      Int?
  /// Series only: whether more episodes are to come.
  seriesStatus     SeriesStatus?
  /// Series only: the day the newest episode was first shown.
  lastAirDate      DateTime?     @db.Date
  /// Shown in prominent places of the viewer site.
  isFeatured       Boolean       @default(false)
  /// Who may watch: everyone the installation lets watch, or only subscribers.
  access           TitleAccess   @default(FREE)
  /// What renting and buying the title costs, in the smallest unit of the
  /// installation's currency. Empty means it is not rented or not sold.
  rentAmount       Int?
  buyAmount        Int?
  /// Set when no subscription opens the title: it is watched by renting or buying only.
  purchaseOnly     Boolean       @default(false)

  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?

  /// A published title is shown to viewers from this moment on. Empty: at once.
  availableFrom  DateTime?
  /// And until this moment. Empty: without an end.
  availableUntil DateTime?

  /// The film itself. Only used for movies.
  assetId        String? @db.Uuid
  asset          Asset?  @relation("TitleMainAsset", fields: [assetId], references: [id], onDelete: SetNull)
  trailerAssetId String? @db.Uuid
  trailerAsset   Asset?  @relation("TitleTrailerAsset", fields: [trailerAssetId], references: [id], onDelete: SetNull)

  posterId   String? @db.Uuid
  poster     Image?  @relation("TitlePoster", fields: [posterId], references: [id], onDelete: SetNull)
  backdropId String? @db.Uuid
  backdrop   Image?  @relation("TitleBackdrop", fields: [backdropId], references: [id], onDelete: SetNull)
  logoId     String? @db.Uuid
  logo       Image?  @relation("TitleLogo", fields: [logoId], references: [id], onDelete: SetNull)

  /// Where the details were imported from, for example "tmdb". Empty for a title typed by hand.
  metadataSource   String?
  /// The id there, with its kind: "movie:603" or "tv:1399".
  metadataId       String?
  /// Language the details were imported in, for example "en-US".
  metadataLanguage String?
  metadataSyncedAt DateTime?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories   TitleCategory[]
  homeSections HomeSectionTitle[]
  plays        Play[]
  genres       TitleGenre[]
  credits      Credit[]
  extras       TitleExtra[]
  translations TitleTranslation[]
  collections  CollectionTitle[]
  packages     TitlePackage[]
  purchases    Purchase[]
  payments     Payment[]
  seasons      Season[]
  watching     WatchProgress[]
  saved        WatchlistItem[]
  watchedFiles WatchedFile[]

  @@index([type, status])
  @@index([type, releaseDate])
  @@index([availableFrom])
  @@index([availableUntil])
  @@index([metadataSource, metadataId])
  @@index([status, publishedAt])
  @@index([createdAt])
  @@map("titles")
}

/// A genre or another grouping that viewers browse by.
model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String   @unique
  description String?
  /// Position in lists. Lower comes first.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  titles       TitleCategory[]
  homeSections HomeSection[]

  @@index([sortOrder])
  @@map("categories")
}

model TitleCategory {
  titleId    String   @db.Uuid
  title      Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([titleId, categoryId])
  @@index([categoryId])
  @@map("title_categories")
}

enum TranslationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  /// Stopped by an admin. What was translated until then stays.
  CANCELLED
  /// Could not go on, for a reason that concerns every title: see the note.
  FAILED
}

/// Translating many titles into one language from the source of their details,
/// one after the other in the background.
model TranslationJob {
  id         String               @id @default(uuid(7)) @db.Uuid
  /// A language tag such as "de".
  language   String
  /// Replaces texts that are translated already. Off, only empty ones are filled.
  overwrite  Boolean              @default(false)
  status     TranslationJobStatus @default(QUEUED)
  /// The titles to go through, in this order.
  titleIds   String[]             @db.Uuid
  /// How many of them were looked at. The next one is titleIds[done].
  done       Int                  @default(0)
  /// Titles that got at least one new text.
  translated Int                  @default(0)
  /// Titles the source had nothing new for.
  unchanged  Int                  @default(0)
  /// Titles that were not imported, so the source has nothing for them.
  skipped    Int                  @default(0)
  failed     Int                  @default(0)
  /// The first failures, as { titleId, name, reason }, for an admin to read.
  failures   Json                 @default("[]")
  /// Why the whole job stopped, when it did.
  note       String?

  createdById String?    @db.Uuid
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, createdAt])
  @@map("translation_jobs")
}

/// The texts of a title in one more language. The title's own fields hold the
/// texts in the language of the catalog. An empty field here falls back to them.
model TitleTranslation {
  titleId  String  @db.Uuid
  title    Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  /// A language tag such as "de" or "pt-BR".
  language String
  name     String?
  tagline  String?
  synopsis String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([titleId, language])
  @@index([language])
  @@map("title_translations")
}

model SeasonTranslation {
  seasonId String  @db.Uuid
  season   Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  language String
  name     String?
  synopsis String?

  @@id([seasonId, language])
  @@map("season_translations")
}

model EpisodeTranslation {
  episodeId String  @db.Uuid
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  language  String
  name      String?
  synopsis  String?

  @@id([episodeId, language])
  @@map("episode_translations")
}

enum ExtraKind {
  TRAILER
  TEASER
  CLIP
  FEATURETTE
  BEHIND_THE_SCENES
  INTERVIEW
  BLOOPERS
}

/// A video that goes with a title beside the film itself: a second trailer, a
/// clip, a look behind the scenes. Extras are free to watch, like the trailer.
model TitleExtra {
  id        String    @id @default(uuid(7)) @db.Uuid
  titleId   String    @db.Uuid
  title     Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  kind      ExtraKind @default(TRAILER)
  name      String
  assetId   String    @db.Uuid
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Order among the extras of the title, from 0.
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([titleId, assetId])
  @@index([titleId, position])
  @@map("title_extras")
}

/// Titles that belong together in an order: the films of a franchise, or a
/// selection an admin puts together. A title can be in several collections.
model Collection {
  id       String  @id @default(uuid(7)) @db.Uuid
  slug     String  @unique
  name     String
  synopsis String  @default("")
  /// A hidden collection is kept in the panel and not offered to viewers.
  visible  Boolean @default(true)
  /// Order among the collections, from 0.
  position Int     @default(0)

  posterId   String? @db.Uuid
  poster     Image?  @relation("CollectionPoster", fields: [posterId], references: [id], onDelete: SetNull)
  backdropId String? @db.Uuid
  backdrop   Image?  @relation("CollectionBackdrop", fields: [backdropId], references: [id], onDelete: SetNull)

  /// Where the collection was imported from, and its id there.
  metadataSource String?
  metadataId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titles       CollectionTitle[]
  homeSections HomeSection[]

  @@unique([metadataSource, metadataId])
  @@index([position])
  @@map("collections")
}

model CollectionTitle {
  collectionId String     @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  titleId      String     @db.Uuid
  title        Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  /// Order inside the collection, from 0.
  position     Int        @default(0)

  @@id([collectionId, titleId])
  @@index([titleId])
  @@map("collection_titles")
}

/// What kind of story a title is: drama, comedy, documentary. Genres come with
/// the details of a title. Categories are the shelves an admin arranges by hand.
model Genre {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titles       TitleGenre[]
  homeSections HomeSection[]

  @@map("genres")
}

model TitleGenre {
  titleId String @db.Uuid
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genreId String @db.Uuid
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  @@index([genreId])
  @@map("title_genres")
}

/// Someone who appears in titles or made them.
model Person {
  id             String  @id @default(uuid(7)) @db.Uuid
  slug           String  @unique
  name           String
  /// What they are mostly known as: "Acting", "Directing".
  knownFor       String?
  biography      String?
  /// The id at the metadata source, so an import finds the person again.
  metadataSource String?
  metadataId     String?
  portraitId     String? @db.Uuid
  portrait       Image?  @relation(fields: [portraitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credits Credit[]

  @@unique([metadataSource, metadataId])
  @@index([name])
  @@map("people")
}

enum CreditKind {
  /// In front of the camera, or a voice.
  CAST
  /// Behind it.
  CREW
}

/// The part one person had in one title.
model Credit {
  id       String     @id @default(uuid(7)) @db.Uuid
  titleId  String     @db.Uuid
  title    Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  personId String     @db.Uuid
  person   Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind     CreditKind
  /// Cast: the character played. Crew: the job, such as "Director".
  role     String?
  /// Where in the list the credit stands, lowest first, within its kind.
  position Int        @default(0)

  @@index([titleId, kind, position])
  @@index([personId])
  @@map("credits")
}

model Season {
  id       String    @id @default(uuid(7)) @db.Uuid
  titleId  String    @db.Uuid
  title    Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  /// Season number as shown to viewers. 0 is used for specials.
  number   Int
  name     String?
  synopsis String?
  /// The day its first episode was first shown.
  airDate  DateTime? @db.Date
  posterId String?   @db.Uuid
  poster   Image?    @relation(fields: [posterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes     Episode[]
  translations SeasonTranslation[]

  @@unique([titleId, number])
  @@map("seasons")
}

model Episode {
  id             String    @id @default(uuid(7)) @db.Uuid
  seasonId       String    @db.Uuid
  season         Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number         Int
  name           String
  synopsis       String?
  /// The day it was first shown.
  airDate        DateTime? @db.Date
  runtimeMinutes Int?

  assetId String? @db.Uuid
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  stillId String? @db.Uuid
  still   Image?  @relation(fields: [stillId], references: [id], onDelete: SetNull)

  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watching WatchProgress[]

  translations EpisodeTranslation[]
  watchedFiles WatchedFile[]

  plays Play[]

  @@unique([seasonId, number])
  @@index([assetId])
  @@map("episodes")
}

/// One of the people who share a viewer account. Each has their own watch
/// history. Every account has a main profile, which is created with it.
model ViewerProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  viewerId  String   @db.Uuid
  viewer    Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  name      String
  /// Name of one of the colours clients draw a profile in, such as "amber".
  color     String
  /// The profile the account starts with. It cannot be deleted.
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ViewerSession[]
  watching WatchProgress[]
  saved    WatchlistItem[]

  @@index([viewerId])
  @@map("viewer_profiles")
}

/// A title a profile put on its list to watch later. One row per profile and title.
model WatchlistItem {
  id        String        @id @default(uuid(7)) @db.Uuid
  viewerId  String        @db.Uuid
  viewer    Viewer        @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  profileId String        @db.Uuid
  profile   ViewerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  titleId   String        @db.Uuid
  title     Title         @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([profileId, titleId])
  @@index([profileId, createdAt])
  @@index([viewerId])
  @@index([titleId])
  @@map("watchlist_items")
}

/// How far a profile is in one video: a movie, or an episode of a series.
/// One row per profile and video.
model WatchProgress {
  id        String        @id @default(uuid(7)) @db.Uuid
  viewerId  String        @db.Uuid
  viewer    Viewer        @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  profileId String        @db.Uuid
  profile   ViewerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  titleId   String        @db.Uuid
  title     Title         @relation(fields: [titleId], references: [id], onDelete: Cascade)
  /// Set for an episode of a series, empty for a movie.
  episodeId String?       @db.Uuid
  episode   Episode?      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  /// The video itself: the id of the episode, or of the title for a movie.
  itemId    String        @db.Uuid

  /// Where to go on. 0 when there is nothing to resume, for example after the end.
  positionSeconds Int
  durationSeconds Int
  /// When the viewer last watched the video to its end.
  completedAt     DateTime?
  /// When the viewer last watched. Comes from the device, never later than now.
  watchedAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, itemId])
  @@index([profileId, watchedAt])
  @@index([viewerId, watchedAt])
  @@index([titleId])
  @@index([episodeId])
  @@map("watch_progress")
}

enum ViewerTokenKind {
  /// Lets the holder set a new password.
  PASSWORD_RESET
  /// Shows that the holder reads mail sent to the viewer's address.
  EMAIL_VERIFICATION
}

/// A link sent to a viewer by email. It works once and for a limited time.
model ViewerToken {
  id        String          @id @default(uuid(7)) @db.Uuid
  viewerId  String          @db.Uuid
  viewer    Viewer          @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  kind      ViewerTokenKind
  /// SHA-256 hash of the token in the link.
  tokenHash String          @unique
  /// The address the link was sent to. A link stops working when the address changes.
  email     String
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([viewerId, kind])
  @@index([expiresAt])
  @@map("viewer_tokens")
}

enum TitleAccess {
  /// Open to everyone the installation lets watch.
  FREE
  /// Needs a subscription.
  PAID
}

enum BillingInterval {
  MONTH
  YEAR
}

/// What a viewer can subscribe to. A plan has a price per month, per year, or both.
/// In this version every plan opens all paid titles.
model Plan {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  description   String?
  /// Short lines shown as a list under the price, such as "Watch on any device".
  features      String[]
  /// Prices in the smallest unit of the installation's currency, such as cents.
  /// A missing price means the plan is not sold for that interval.
  monthlyAmount Int?
  yearlyAmount  Int?
  /// Days a new subscriber watches before the first payment.
  trialDays     Int      @default(0)
  /// Whether viewers are offered the plan. Existing subscribers keep it either way.
  isOffered     Boolean  @default(true)
  /// Marks the plan viewers are steered to.
  isRecommended Boolean  @default(false)
  /// Whether the plan opens every paid title. Otherwise it opens its packages.
  includesAll   Boolean  @default(true)
  /// Order on the page of plans, lowest first.
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  packages      PlanPackage[]

  @@index([position])
  @@map("plans")
}

enum SubscriptionStatus {
  /// Watching without having paid yet.
  TRIALING
  ACTIVE
  /// A payment failed. Access continues while the payment is retried.
  PAST_DUE
  /// Ended by the viewer or an admin. Nothing more is charged.
  CANCELED
  /// The paid time ran out.
  EXPIRED
}

enum SubscriptionSource {
  /// Granted by an admin: cash, bank transfer, a gift.
  MANUAL
  /// Paid online.
  STRIPE
}

/// A viewer's hold on a plan over a stretch of time. A viewer has at most one
/// that is running. Ended ones are kept as the history of the account.
model Subscription {
  id       String             @id @default(uuid(7)) @db.Uuid
  viewerId String             @db.Uuid
  viewer   Viewer             @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  planId   String             @db.Uuid
  plan     Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status   SubscriptionStatus
  source   SubscriptionSource
  /// How often it is paid. Empty for access an admin granted.
  interval BillingInterval?

  startedAt         DateTime  @default(now())
  /// Until when the viewer may watch. Empty means until an admin ends it.
  /// For a subscription paid online that renews, a few days after renewsAt,
  /// so a late message from the payment provider locks nobody out.
  endsAt            DateTime?
  /// When the next payment is due. Empty when it is not renewed.
  renewsAt          DateTime?
  /// What one interval costs, in the smallest unit of the currency. Empty for
  /// access an admin granted.
  amount            Int?
  /// Set when it will not be renewed at endsAt.
  cancelAtPeriodEnd Boolean   @default(false)
  /// When it was ended before its time, by the viewer or an admin.
  canceledAt        DateTime?

  /// A remark of the admin who granted it, such as "paid in cash".
  note        String?
  grantedById String?    @db.Uuid
  grantedBy   AdminUser? @relation(fields: [grantedById], references: [id], onDelete: SetNull)
  /// Id of the subscription at the payment provider.
  externalId  String?    @unique
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([viewerId, status])
  @@index([planId])
  @@index([status, endsAt])
  @@map("subscriptions")
}

/// A message Stripe sent about a payment or a subscription. Kept for a while
/// so the same message is not handled twice and the panel can show the last one.
model StripeEvent {
  /// Stripe's id of the event, such as "evt_1Q...".
  id          String    @id
  type        String
  livemode    Boolean
  receivedAt  DateTime  @default(now())
  /// Empty while it is handled, or when handling it failed.
  processedAt DateTime?
  /// Why handling it failed, when it did.
  error       String?

  @@index([receivedAt])
  @@map("stripe_events")
}

enum PaymentStatus {
  PAID
  /// Part of the money was returned.
  PARTIALLY_REFUNDED
  /// All of the money was returned.
  REFUNDED
}

/// Money a viewer paid for a subscription: collected by Stripe, or received
/// by the operator and written down by an admin. The books of the site.
model Payment {
  id                String             @id @default(uuid(7)) @db.Uuid
  /// Empty once the account is deleted. The payment stays in the books.
  viewerId          String?            @db.Uuid
  viewer            Viewer?            @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  /// The email address of the viewer when they paid, kept beyond the account.
  viewerEmail       String
  subscriptionId    String?            @db.Uuid
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId            String?            @db.Uuid
  plan              Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// The name of the plan when it was paid for.
  planName          String?
  /// What was paid for: a subscription, or renting or buying one title.
  kind              PaymentKind        @default(SUBSCRIPTION)
  titleId           String?            @db.Uuid
  title             Title?             @relation(fields: [titleId], references: [id], onDelete: SetNull)
  /// The name of the title when it was paid for.
  titleName         String?
  purchase          Purchase?
  source            SubscriptionSource
  status            PaymentStatus      @default(PAID)
  /// What was paid, tax included, in the smallest unit of the currency.
  amount            Int
  /// How much of it is tax, when the provider worked it out.
  taxAmount         Int                @default(0)
  /// How much of it was returned.
  refundedAmount    Int                @default(0)
  /// Three capital letters, such as "EUR".
  currency          String
  paidAt            DateTime
  /// The stretch of the subscription it paid for.
  periodStart       DateTime?
  periodEnd         DateTime?
  /// Id of the invoice at the payment provider.
  externalId        String?            @unique
  /// Id of the payment itself at the provider, by which a refund finds it.
  externalPaymentId String?
  invoiceNumber     String?
  /// Where the viewer reads and downloads the invoice.
  invoiceUrl        String?
  /// A remark of the admin who wrote it down, such as "cash, receipt 114".
  note              String?
  recordedById      String?            @db.Uuid
  recordedBy        AdminUser?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([paidAt])
  @@index([viewerId, paidAt])
  @@index([externalPaymentId])
  @@map("payments")
}

/// A group of paid titles that plans open together, such as "Kids" or
/// "Sports". What a cable operator calls a bouquet.
model Package {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  /// Order in lists, lowest first.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  titles   TitlePackage[]
  channels ChannelPackage[]
  plans    PlanPackage[]

  @@index([position])
  @@map("packages")
}

model TitlePackage {
  titleId   String  @db.Uuid
  title     Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  packageId String  @db.Uuid
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([titleId, packageId])
  @@index([packageId])
  @@map("title_packages")
}

/// A channel in a package. Plans that include the package open the channel.
model ChannelPackage {
  channelId String  @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  packageId String  @db.Uuid
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([channelId, packageId])
  @@index([packageId])
  @@map("channel_packages")
}

model PlanPackage {
  planId    String  @db.Uuid
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  packageId String  @db.Uuid
  /// A package that plans include is not deleted from under them.
  package   Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@id([planId, packageId])
  @@index([packageId])
  @@map("plan_packages")
}

enum PaymentKind {
  SUBSCRIPTION
  RENTAL
  PURCHASE
}

enum PurchaseKind {
  /// Watching for a limited time.
  RENT
  /// Watching for as long as the title is on the site.
  BUY
}

enum PurchaseStatus {
  ACTIVE
  /// The money was returned, or an admin took it back.
  REVOKED
}

/// A viewer's right to watch one title, rented or bought, whatever plan they
/// have or have not.
model Purchase {
  id          String             @id @default(uuid(7)) @db.Uuid
  viewerId    String             @db.Uuid
  viewer      Viewer             @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  titleId     String             @db.Uuid
  title       Title              @relation(fields: [titleId], references: [id], onDelete: Cascade)
  kind        PurchaseKind
  status      PurchaseStatus     @default(ACTIVE)
  source      SubscriptionSource
  createdAt   DateTime           @default(now())
  /// When a rented title was first played. The time to finish it runs from then.
  startedAt   DateTime?
  /// Until when it may be watched. Empty for a bought title.
  expiresAt   DateTime?
  /// The payment in the books, when money was paid.
  paymentId   String?            @unique @db.Uuid
  payment     Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  /// Id of the checkout at the payment provider.
  externalId  String?            @unique
  /// A remark of the admin who gave it, such as "prize of the raffle".
  note        String?
  grantedById String?            @db.Uuid
  grantedBy   AdminUser?         @relation(fields: [grantedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime           @updatedAt

  @@index([viewerId, titleId])
  @@index([titleId])
  @@map("purchases")
}

// ── Live ─────────────────────────────────────────────────────────────

/// What a live process last reported about a channel.
enum ChannelStatus {
  STOPPED
  /// Switched on and waiting for an encoder to connect. Only for channels that are pushed.
  IDLE
  STARTING
  RUNNING
  RECONNECTING
  FAILED
}

/// Where the video of a channel comes from.
enum ChannelIngest {
  /// The server connects to an address and pulls the stream.
  PULL
  /// An encoder connects to the server and pushes the stream, with a stream key.
  PUSH
}

/// How a channel is made from its source.
enum ChannelMode {
  /// The picture is passed on as it arrives. One quality, almost no CPU.
  COPY
  /// The picture is encoded again, into several qualities.
  TRANSCODE
}

/// A live channel. The platform pulls its source and repackages it for players.
model Channel {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String
  /// Name for addresses, such as "news-24".
  slug        String  @unique
  /// Channel number on a remote control. Optional.
  number      Int?    @unique
  description String?

  ingest ChannelIngest @default(PULL)

  /// Address of the source of a pulled channel, encrypted with the master key: it may carry a password.
  sourceEncrypted    String?
  /// SHA-256 of the stream key of a pushed channel, to find the channel an encoder publishes to.
  streamKeyHash      String? @unique
  /// The stream key, encrypted with the master key, to show it to admins again.
  streamKeyEncrypted String?
  /// The source without credentials or query, for display.
  sourceLabel        String

  mode      ChannelMode @default(COPY)
  /// Picture heights to encode with TRANSCODE, such as 1080, 720, 480. Heights above the source are left out.
  qualities Int[]       @default([])

  /// Minutes viewers can go back in time on the channel. 0 means only the present.
  dvrMinutes Int @default(0)

  recordings Recording[]

  /// The id of this channel in guide sources (XMLTV), to file imported programmes under it.
  guideId    String?
  programmes Programme[]

  /// Whether viewers find the channel on the website and in the apps.
  published Boolean          @default(false)
  /// FREE is as open as the installation. PAID needs a plan that opens the channel.
  access    TitleAccess      @default(FREE)
  packages  ChannelPackage[]

  /// The wanted state: a live process keeps an enabled channel running.
  enabled       Boolean       @default(false)
  status        ChannelStatus @default(STOPPED)
  statusMessage String?
  /// When the running stream started. Null while not running.
  startedAt     DateTime?
  /// Restarts since the channel was last started by an admin.
  restartCount  Int           @default(0)
  /// Raised to ask the live process for a restart.
  restartToken  Int           @default(0)

  /// What the source carries, as last probed.
  videoCodec    String?
  width         Int?
  height        Int?
  frameRate     Float?
  audioCodec    String?
  audioChannels Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("channels")
}

// ── Programme guide ──────────────────────────────────────────────────

/// A place the programme guide is imported from: an XMLTV file at an address.
model GuideSource {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @unique

  /// Address of the file, encrypted with the master key: it may carry a token.
  urlEncrypted String
  /// The address without credentials or query, for display.
  urlLabel     String
  /// Whether the source is imported again by itself.
  enabled      Boolean @default(true)

  /// The last import: when it ended, whether it worked, what it said and how many programmes it brought.
  lastRunAt      DateTime?
  lastOk         Boolean?
  lastMessage    String?
  lastProgrammes Int?

  channels   GuideSourceChannel[]
  programmes Programme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guide_sources")
}

/// A channel a guide source knows. Offered when a channel is linked to the guide.
model GuideSourceChannel {
  sourceId String      @db.Uuid
  source   GuideSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// The id the source uses for the channel.
  guideId  String
  name     String

  @@id([sourceId, guideId])
  @@index([guideId])
  @@map("guide_source_channels")
}

/// One programme on a channel.
model Programme {
  id        String       @id @default(uuid(7)) @db.Uuid
  channelId String       @db.Uuid
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// The source it was imported from. Null for a programme an admin entered.
  sourceId  String?      @db.Uuid
  source    GuideSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  title       String
  subtitle    String?
  description String?
  category    String?
  startsAt    DateTime
  endsAt      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId, startsAt])
  @@index([channelId, endsAt])
  @@index([sourceId])
  @@map("programmes")
}

// ── Recordings ───────────────────────────────────────────────────────

enum RecordingStatus {
  /// Waiting for its start.
  SCHEDULED
  /// A live process is writing it.
  RECORDING
  /// Recorded. The file is being put into the library.
  FINISHING
  /// In the library as an asset.
  DONE
  FAILED
  /// Called off before it started.
  CANCELLED
}

/// A stretch of a live channel kept as a file, which becomes an asset in the library.
model Recording {
  id    String @id @default(uuid(7)) @db.Uuid
  title String

  /// The channel it is recorded from. Null once that channel is deleted.
  channelId   String?  @db.Uuid
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  /// The name of the channel when the recording was made, kept for the list.
  channelName String

  startsAt DateTime
  endsAt   DateTime

  status          RecordingStatus @default(SCHEDULED)
  statusMessage   String?
  /// How much was really recorded, which is less when the channel was off air for a while.
  recordedSeconds Int?
  bytes           BigInt?

  /// What the recording became in the library.
  assetId String? @unique @db.Uuid
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdById String?    @db.Uuid
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
  @@index([channelId])
  @@map("recordings")
}

// --- Delivery --------------------------------------------------------------------

/// A server that delivers video to viewers in place of the main server. It runs
/// the edge agent, which keeps copies of what it is asked for.
model EdgeServer {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @unique

  /// The address viewers reach it at, such as https://edge1.example.com.
  publicUrl String  @unique
  /// Where it stands, as a note for the operator.
  location  String?

  /// Hash of the secret the agent signs in with. The secret itself is shown once.
  secretHash String

  /// Switched off, it gets no new viewers. The agent may stay connected.
  enabled    Boolean @default(true)
  /// Its share of viewers compared with the other edges, 1 to 100.
  weight     Int     @default(10)
  serveVideo Boolean @default(true)
  serveLive  Boolean @default(true)

  /// What the agent last said about itself.
  lastSeenAt DateTime?
  version    String?
  hostname   String?
  remoteIp   String?

  /// Everything it delivered since it was added.
  bytesServed    BigInt @default(0)
  requestsServed BigInt @default(0)

  trafficHours EdgeTrafficHour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("edge_servers")
}

/// What an edge delivered in one hour. Written from its heartbeats, kept for
/// the history of the Edge servers page.
model EdgeTrafficHour {
  edgeId String     @db.Uuid
  edge   EdgeServer @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  /// The start of the hour, in UTC.
  hour   DateTime

  bytes        BigInt @default(0)
  requests     BigInt @default(0)
  /// Requests answered from copies on the edge, and those fetched first.
  hits         BigInt @default(0)
  misses       BigInt @default(0)
  /// What the edge had to fetch from the main server to deliver this.
  fetchedBytes BigInt @default(0)

  @@id([edgeId, hour])
  @@index([hour])
  @@map("edge_traffic_hours")
}

/// What the players of viewers reported for one hour: how much of what they
/// played came from servers and how much from other viewers.
model SharingHour {
  /// The start of the hour, in UTC.
  hour DateTime
  /// "video" or "live".
  kind String

  fromServers BigInt @default(0)
  fromViewers BigInt @default(0)
  /// What players gave to others. Close to fromViewers, counted at the other end.
  toViewers   BigInt @default(0)
  /// How many reports the figures are made of.
  reports     Int    @default(0)

  @@id([hour, kind])
  @@map("sharing_hours")
}

/// What the gateway of the main server sent to viewers itself in one hour,
/// as counted by the gateway.
model OriginTrafficHour {
  /// The start of the hour, in UTC.
  hour DateTime
  /// "video" or "live".
  kind String

  bytes    BigInt @default(0)
  requests BigInt @default(0)

  @@id([hour, kind])
  @@map("origin_traffic_hours")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

enum BackupStatus {
  /// Asked for, and waiting for the scheduler to pick it up.
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
}

/// One backup of the database: an encrypted file in a storage pool.
model Backup {
  id      String        @id @default(uuid(7)) @db.Uuid
  status  BackupStatus  @default(PENDING)
  trigger BackupTrigger

  storagePoolId String      @db.Uuid
  storagePool   StoragePool @relation(fields: [storagePoolId], references: [id])
  /// Where the file is in the pool. Set when the backup starts.
  storageKey    String?
  /// Size of the encrypted file.
  sizeBytes     BigInt?
  /// SHA-256 of the encrypted file, in hexadecimal.
  sha256        String?
  /// How many database objects the file holds, counted when it was read back.
  entries       Int?

  /// The version of the application that wrote the backup.
  appVersion String
  /// The newest migration the database had.
  migration  String?
  /// Why the backup failed.
  error      String?

  createdById String?    @db.Uuid
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([createdAt])
  @@index([status])
  @@map("backups")
}

// ---------------------------------------------------------------------------
// The home page of the website
// ---------------------------------------------------------------------------

/// A page of the website that can be arranged in the panel.
enum LayoutPage {
  HOME
  /// The page "Movies" leads to.
  MOVIES
  /// The page "Series" leads to.
  SERIES
  /// The page of the live channels: what stands under the channels.
  LIVE
  /// The page of a category. One arrangement serves every category, each showing its own titles.
  CATEGORY
  /// The page of a genre, in the same way.
  GENRE
}

enum HomeSectionKind {
  /// The opening of the page: one title shown large, or a few that take turns.
  HERO
  /// Where the viewer's own row of started videos goes.
  CONTINUE_WATCHING
  /// Where the viewer's own list of saved titles goes.
  MY_LIST
  /// A row of titles.
  TITLES
}

/// Which titles a section shows.
enum HomeSource {
  /// Every title.
  ALL
  /// The titles marked as featured.
  FEATURED
  CATEGORY
  GENRE
  COLLECTION
  /// Titles picked one by one, in the order they were put.
  MANUAL
}

enum HomeSort {
  /// The order of the collection, or of the picked titles.
  CURATED
  /// Last published first.
  NEWEST
  /// Latest premiere first.
  RELEASED
  /// Best rated first.
  RATING
  NAME
}

/// How the cards of a row look.
enum HomeLayout {
  POSTER
  /// Wide cards with the backdrop.
  LANDSCAPE
  /// Posters with their place in the row beside them: a top ten.
  NUMBERED
}

/// One part of a page of the website. A page without any is put together by itself.
model HomeSection {
  id       String          @id @default(uuid(7)) @db.Uuid
  /// The page the section is on.
  page     LayoutPage      @default(HOME)
  /// Order on the page, from 0. The hero opens the page wherever it stands.
  position Int             @default(0)
  kind     HomeSectionKind
  /// The heading. Empty, the section is named after what it shows.
  name     String?

  source       HomeSource  @default(ALL)
  categoryId   String?     @db.Uuid
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  genreId      String?     @db.Uuid
  genre        Genre?      @relation(fields: [genreId], references: [id], onDelete: Cascade)
  collectionId String?     @db.Uuid
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// Only movies, or only series. Null: both.
  titleType    TitleType?
  sort         HomeSort    @default(NEWEST)
  /// The most titles shown.
  limit        Int         @default(20)
  layout       HomeLayout  @default(POSTER)

  /// A hidden section stays in the panel and is not shown.
  visible      Boolean   @default(true)
  /// Shown from this moment, and until that one. For rows of a season.
  visibleFrom  DateTime?
  visibleUntil DateTime?

  titles    HomeSectionTitle[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([page, position])
  @@map("home_sections")
}

/// A title picked for a section, with its place in it.
model HomeSectionTitle {
  sectionId String      @db.Uuid
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  titleId   String      @db.Uuid
  title     Title       @relation(fields: [titleId], references: [id], onDelete: Cascade)
  position  Int         @default(0)

  @@id([sectionId, titleId])
  @@index([titleId])
  @@map("home_section_titles")
}

// ---------------------------------------------------------------------------
// What is watched
// ---------------------------------------------------------------------------

enum PlayKind {
  /// The movie or the episode itself.
  MAIN
  TRAILER
  EXTRA
}

enum PlayDevice {
  DESKTOP
  MOBILE
  TABLET
  TV
  OTHER
}

/// One time a video was asked for and, if it was, watched. Made when the
/// addresses for playing are handed out, and filled in by the player while it
/// plays. Holds no address and no description of the device.
model Play {
  id   String   @id @default(uuid(7)) @db.Uuid
  kind PlayKind @default(MAIN)

  /// Emptied when the title or episode is deleted. The figures stay.
  titleId   String?  @db.Uuid
  title     Title?   @relation(fields: [titleId], references: [id], onDelete: SetNull)
  episodeId String?  @db.Uuid
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  /// The signed-in viewer. Emptied when the account is deleted.
  viewerId   String? @db.Uuid
  viewer     Viewer? @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  /// For visitors who are not signed in: a mark that is the same for one
  /// device during one day, and from which nothing about it can be read back.
  visitorKey String?

  device          PlayDevice @default(OTHER)
  /// Whether the title needed a subscription or a purchase when it was played.
  paid            Boolean    @default(false)
  /// Length of the video.
  durationSeconds Int        @default(0)
  /// How long it actually played, counted by the player.
  watchedSeconds  Int        @default(0)
  /// The furthest point reached.
  positionSeconds Int        @default(0)

  startedAt  DateTime @default(now())
  lastBeatAt DateTime @default(now())

  @@index([startedAt])
  @@index([titleId, startedAt])
  @@index([lastBeatAt])
  @@map("plays")
}
