# Admin panel, for development. Copy to apps/admin/.env. Vite reads this file
# from here, not from the .env at the root of the repository.
#
# In an installation none of these are needed: the gateway serves the panel
# under /admin/ of the site and passes /v1 on to the API.

# Where the development server passes requests to /v1 on to.
ONYX_API_URL=http://localhost:3000
# Where the panel lives on its address. "/" in development, "/admin/" behind
# the gateway.
ADMIN_BASE_PATH=/
# Address of the viewer website, for the links from the panel to the site.
VITE_SITE_URL=http://localhost:3001
