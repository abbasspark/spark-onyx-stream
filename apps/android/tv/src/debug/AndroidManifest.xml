<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Debug builds only: lets the app reach a server on the development
      machine over plain HTTP (the emulator's name for the host is 10.0.2.2).
      A release build does not have this file, and Android blocks plain HTTP.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
