# Address of the main server, as this edge reaches it.
ONYX_ORIGIN_URL=https://stream.example.com

# Token of this edge. Shown once when the edge is added in the admin panel
# (Delivery -> Edge servers). Keep it like a password.
ONYX_EDGE_TOKEN=

# The domain viewers reach this edge at. It must point to this server, and it
# is the address entered for the edge in the admin panel, with https:// in front.
EDGE_DOMAIN=edge1.example.com

# How much video may be kept on this server.
ONYX_EDGE_CACHE_SIZE=50GB
