# Settings of the Docker Compose installation.
# Run ./init-env.sh to create .env from this file with fresh secrets.
# Never commit the .env file, and keep a copy of it in a safe place:
# without MASTER_KEY, encrypted videos and stored S3 credentials are lost.

# Port on this server where the website, the panel, the API and the media are reachable.
HTTP_PORT=8080

# --- Viewer website -------------------------------------------------------
# Name in the header, the browser tab and link previews.
SITE_NAME=Onyx Stream
# One sentence about the site, for search engines.
SITE_DESCRIPTION=Movies and series, streamed to you.
# The address viewers type, without a slash at the end, for example
# https://watch.example.com. Used in the sitemap and in link previews.
SITE_URL=http://localhost:8080

# --- Database -------------------------------------------------------------
POSTGRES_USER=onyx
POSTGRES_DB=onyx
POSTGRES_PASSWORD=

# --- Secrets (filled in by init-env.sh) -----------------------------------
# Signs admin sessions.
JWT_SECRET=
# Signs playback URLs. The gateway checks them with the same value.
PLAYBACK_SIGNING_SECRET=
# Encrypts content keys and storage credentials at rest.
MASTER_KEY=

# --- Optional -------------------------------------------------------------
# Processing jobs one worker container runs at the same time.
WORKER_CONCURRENCY=1
# How long a playback URL stays valid, in seconds.
PLAYBACK_URL_TTL_SECONDS=21600
# Who may play published titles through the public catalog (/v1/catalog).
# open: anyone who can reach the site. off: nobody, the catalog can still be browsed.
# Viewer accounts are not built yet, so "open" really means everyone.
CATALOG_PLAYBACK=open
# Largest accepted source file in bytes. The default is 50 GiB.
UPLOAD_MAX_BYTES=53687091200
# Origin that serves media files when it is not the one players get the URL
# from, for example https://media.example.com. Usually empty.
MEDIA_BASE_URL=
# Other websites allowed to call the API from a browser, separated by commas.
CORS_ORIGINS=
# Reverse proxies in front of the API. The gateway is one. Add one for each
# further proxy in front of the gateway, such as a TLS proxy.
TRUST_PROXY_HOPS=1
