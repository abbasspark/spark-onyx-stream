# Settings of the Docker Compose installation.
# Run ./init-env.sh to create .env from this file with fresh secrets.
# Never commit the .env file, and keep a copy of it in a safe place:
# without MASTER_KEY, encrypted videos and stored S3 credentials are lost.

# Port on this server where the website, the panel, the API and the media are reachable.
HTTP_PORT=8080

# --- Viewer website -------------------------------------------------------
# Name in the header, the browser tab and link previews.
SITE_NAME=Onyx Stream
# One sentence about the site, for search engines.
SITE_DESCRIPTION=Movies and series, streamed to you.
# The address viewers type, without a slash at the end, for example
# https://watch.example.com. Used in the sitemap and in link previews.
SITE_URL=http://localhost:8080

# --- Database -------------------------------------------------------------
POSTGRES_USER=onyx
POSTGRES_DB=onyx
POSTGRES_PASSWORD=

# --- Secrets (filled in by init-env.sh) -----------------------------------
# Signs admin sessions.
JWT_SECRET=
# Signs playback URLs. The gateway checks them with the same value.
PLAYBACK_SIGNING_SECRET=
# Encrypts content keys and storage credentials at rest.
MASTER_KEY=

# --- Optional -------------------------------------------------------------
# Processing jobs one worker container runs at the same time.
WORKER_CONCURRENCY=1
# Length of a live segment in seconds, and how many a live playlist lists.
# Shorter segments mean less delay behind the source and more requests.
LIVE_SEGMENT_SECONDS=4
LIVE_PLAYLIST_SEGMENTS=6
# Speed of the encoder for transcoded channels: ultrafast, superfast, veryfast,
# faster, fast or medium. Faster uses less CPU for a slightly worse picture.
LIVE_TRANSCODE_PRESET=veryfast

# Hours after which the programme guide is imported again from its sources.
GUIDE_REFRESH_HOURS=6

# Encoders push to live channels on these ports: RTMP (TCP) and SRT (UDP).
# Open them in the firewall.
INGEST_RTMP_PORT=1935
INGEST_SRT_PORT=8890
# Addresses encoders reach the server at, as shown to admins, such as
# rtmp://stream.example.com:1935 and srt://stream.example.com:8890. Empty, the
# panel shows its own host name with the usual ports.
INGEST_PUBLIC_RTMP_URL=
INGEST_PUBLIC_SRT_URL=
# How long a playback URL stays valid, in seconds.
PLAYBACK_URL_TTL_SECONDS=21600
# Who may play published titles through the public catalog (/v1/catalog).
# open: anyone who can reach the site, without an account.
# viewers: only signed-in viewers.
# off: nobody. The catalog can be browsed in every case.
CATALOG_PLAYBACK=open
# Whether people can create a viewer account themselves.
# open: yes. closed: only admins create viewers, in the panel.
VIEWER_REGISTRATION=open
# Whether a viewer must confirm their email address before they can watch.
# optional: no. required: yes, when playback needs a viewer. Needs SMTP_URL.
VIEWER_EMAIL_VERIFICATION=optional

# --- Email ------------------------------------------------------------------
# Mail server for the emails viewers get: confirming an address and setting a
# new password. Empty turns email off.
# Port 465: smtps://user:password@smtp.example.com:465
# Port 587: smtp://user:password@smtp.example.com:587
# Special characters in the user name or password must be percent-encoded.
SMTP_URL=
# Sender of those emails. Needed with SMTP_URL. The links in the emails lead
# to SITE_URL, so set that to the address people really use.
MAIL_FROM=Onyx Stream <no-reply@example.com>
# Largest accepted source file in bytes. The default is 50 GiB.
UPLOAD_MAX_BYTES=53687091200
# Origin that serves media files when it is not the one players get the URL
# from, for example https://media.example.com. Usually empty.
MEDIA_BASE_URL=
# Other websites allowed to call the API from a browser, separated by commas.
CORS_ORIGINS=
# Reverse proxies in front of the API. The gateway is one. Add one for each
# further proxy in front of the gateway, such as a TLS proxy.
TRUST_PROXY_HOPS=1


# --- Billing ----------------------------------------------------------------
# Currency of all prices, as three capital letters. Decide before you create
# the first plan: prices are stored as numbers and do not convert themselves.
BILLING_CURRENCY=EUR
# Where viewers ask for a subscription while the site takes no payments online:
# a web address, or mailto:billing@example.com. Empty shows no link.
BILLING_CONTACT_URL=
# Renting a title: days a viewer has to start watching, and hours to finish
# once they started.
RENTAL_START_DAYS=30
RENTAL_WATCH_HOURS=48
# Online payment with Stripe. Empty means none: access is granted by an admin.
# The secret key is under Developers > API keys at Stripe. It starts with
# sk_test_ while testing, where no money moves, and sk_live_ for real payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint at Stripe (Developers > Webhooks),
# which starts with whsec_. The endpoint is the address of the API followed by
# /v1/billing/stripe/webhook. Required with the key, as is SITE_URL above.
# The steps are in docs/phase-3-billing.md.
STRIPE_WEBHOOK_SECRET=
# true lets Stripe Tax work out the tax of each payment. Prices then include it.
STRIPE_AUTOMATIC_TAX=false

# --- Import of details ------------------------------------------------------
# Access to The Movie Database (TMDB), to import details, artwork and episodes
# of titles in the admin panel. Take the "API Read Access Token" (or the
# shorter "API Key") from https://www.themoviedb.org/settings/api.
# Empty turns the import off. TMDB is free for sites that earn no money; a
# site that sells access needs an agreement with TMDB.
TMDB_API_TOKEN=
# Language details are imported in when the admin does not choose one.
METADATA_LANGUAGE=en-US
# Country whose age ratings are imported.
METADATA_REGION=US