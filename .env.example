# Copy this file to .env and adjust the values.
# Never commit the .env file.

# --- Database -------------------------------------------------------------
POSTGRES_USER=onyx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onyx
POSTGRES_PORT=5432
DATABASE_URL=postgresql://onyx:change-me@localhost:5432/onyx

# Separate database for end-to-end tests. Tests delete data in it, so it must
# never be the same as DATABASE_URL. Leave empty to skip those tests.
TEST_DATABASE_URL=postgresql://onyx:change-me@localhost:5432/onyx_test

# Optional: an S3-compatible service for the S3 storage driver tests.
# The bucket must already exist. Leave TEST_S3_ENDPOINT empty to skip those tests.
TEST_S3_ENDPOINT=
TEST_S3_REGION=us-east-1
TEST_S3_BUCKET=onyx-test
TEST_S3_ACCESS_KEY_ID=
TEST_S3_SECRET_ACCESS_KEY=

# --- Redis (queue, cache, pub/sub) ----------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ------------------------------------------------------------------
API_PORT=3000
# The address the API listens on. 0.0.0.0 accepts connections from other
# machines; 127.0.0.1 only from this one.
API_HOST=0.0.0.0
# Role of this process: api | worker | live | scheduler | all
APP_ROLE=all

# --- Uploads --------------------------------------------------------------
# Directory where uploads are collected before they move into a storage pool.
# A relative path is resolved against the folder of this file.
UPLOAD_TEMP_PATH=./uploads
# Largest accepted source file in bytes. The default is 50 GiB.
UPLOAD_MAX_BYTES=53687091200

# --- Processing -----------------------------------------------------------
# Programs used for media processing. A name is looked up on the PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Working directory of processing jobs. It needs room for a source file and
# its outputs. A relative path is resolved against the folder of this file.
PROCESSING_TEMP_PATH=./tmp/processing
# Processing jobs one worker process runs at the same time.
# Transcoding already uses all CPU cores, so 1 is right for most servers.
WORKER_CONCURRENCY=1

# --- Live -----------------------------------------------------------------
# Folder live channels write their playlists and segments to. The files are
# temporary and small: a few megabytes per running channel.
LIVE_PATH=./tmp/live
# Wanted length of a live segment in seconds. Shorter means less delay behind
# the source and more requests. Segments end on key frames of the source.
LIVE_SEGMENT_SECONDS=4
# Segments a live playlist lists. Players can go back this far.
LIVE_PLAYLIST_SEGMENTS=6
# Speed setting of the H.264 encoder for transcoded channels: ultrafast,
# superfast, veryfast, faster, fast or medium. Faster settings use less CPU and
# give a slightly worse picture at the same bitrate.
LIVE_TRANSCODE_PRESET=veryfast

# Hours after which the programme guide is imported again from its sources.
GUIDE_REFRESH_HOURS=6

# The ingest server (MediaMTX) receives the streams encoders push to live
# channels. "pnpm dev:infra" starts one with these addresses.
INGEST_API_URL=http://127.0.0.1:9997
INGEST_RTSP_URL=rtsp://127.0.0.1:8554
# Addresses encoders reach it at, as shown to admins. Empty, the panel shows
# its own host name with the usual ports (1935 for RTMP, 8890 for SRT).
INGEST_PUBLIC_RTMP_URL=
INGEST_PUBLIC_SRT_URL=

# --- Playback -------------------------------------------------------------
# How long a playback URL stays valid, in seconds. The default is six hours.
# Videos longer than that get more time automatically.
PLAYBACK_URL_TTL_SECONDS=21600
# Origin that serves media files, for example https://media.example.com.
# Leave empty while the API serves them itself.
MEDIA_BASE_URL=
# Who may play published titles through the public catalog (/v1/catalog).
# open: anyone who can reach the site, without an account.
# viewers: only signed-in viewers.
# off: nobody. The catalog can be browsed in every case.
CATALOG_PLAYBACK=open
# Whether every admin has to use two-factor sign-in: a code from an
# authenticator app on top of the password.
# optional: each admin decides. required: an admin without it can sign in and
# do nothing but set it up.
ADMIN_TWO_FACTOR=optional
# Whether people can create a viewer account themselves.
# open: yes. closed: only admins create viewers, in the panel.
VIEWER_REGISTRATION=open
# Whether a viewer must confirm their email address before they can watch.
# optional: no. required: yes, when playback needs a viewer. Needs SMTP_URL.
VIEWER_EMAIL_VERIFICATION=optional

# --- P2P between viewers ----------------------------------------------------
# Address players reach the tracker at, such as wss://stream.example.com/tracker.
# Empty switches P2P off.
P2P_TRACKER_URL=
# Where the API reaches the tracker to read its figures.
P2P_TRACKER_INTERNAL_URL=http://127.0.0.1:8070
# Shared by the API and the tracker (its ONYX_TRACKER_SECRET), which lets in
# only viewers the API lets watch.
P2P_TRACKER_SECRET=
# STUN servers the players of viewers use to find the address others reach them
# at, separated by commas. These public ones learn the addresses of your
# viewers: use your own if that matters to you.
P2P_STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
# A TURN server passes data on between viewers who cannot reach each other
# directly, such as turn:turn.example.com:3478, with the secret it makes
# short-lived passwords from (coturn: static-auth-secret). Empty uses none.
P2P_TURN_URLS=
P2P_TURN_SECRET=
# Whether the players of viewers share until the viewer says otherwise: on or off.
P2P_VIEWER_DEFAULT=on

# --- Gateway ----------------------------------------------------------------
# Where the API reaches the gateway in front of it, such as http://gateway:8080,
# to count what the gateway sent to viewers itself. Empty where there is none.
GATEWAY_INTERNAL_URL=

# --- Email ------------------------------------------------------------------
# Mail server for the emails viewers get: confirming an address and setting a
# new password. Empty turns email off.
# Port 465: smtps://user:password@smtp.example.com:465
# Port 587: smtp://user:password@smtp.example.com:587
# Special characters in the user name or password must be percent-encoded.
SMTP_URL=
# Sender of those emails. Needed with SMTP_URL.
MAIL_FROM=Onyx Stream <no-reply@example.com>
# Address of the viewer website, for the links in emails. Needed with SMTP_URL.
SITE_URL=http://localhost:3001
# Name of the site, until one is set in the panel under Settings > Branding.
SITE_NAME=Onyx Stream

# --- Webhooks ---------------------------------------------------------------
# Where webhooks made in the panel may send to. "any" allows every address the
# server can reach, also localhost and private networks. "public" refuses those,
# for installations whose admins should not be able to call into the network.
WEBHOOK_TARGETS=any

# --- Billing ----------------------------------------------------------------
# Currency of all prices, as three capital letters. Decide before you create
# the first plan: prices are stored as numbers and do not convert themselves.
BILLING_CURRENCY=EUR
# Where viewers ask for a subscription while the site takes no payments online:
# a web address, or mailto:billing@example.com. Empty shows no link.
BILLING_CONTACT_URL=
# Renting a title: days a viewer has to start watching, and hours to finish
# once they started.
RENTAL_START_DAYS=30
RENTAL_WATCH_HOURS=48
# Online payment with Stripe. Empty means none: access is granted by an admin.
# The secret key is under Developers > API keys at Stripe. It starts with
# sk_test_ while testing, where no money moves, and sk_live_ for real payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint at Stripe (Developers > Webhooks),
# which starts with whsec_. The endpoint is the address of the API followed by
# /v1/billing/stripe/webhook. Required with the key, as is SITE_URL above.
# The steps are in docs/phase-3-billing.md.
STRIPE_WEBHOOK_SECRET=
# true lets Stripe Tax work out the tax of each payment. Prices then include it.
STRIPE_AUTOMATIC_TAX=false

# --- Import of details ------------------------------------------------------
# Access to The Movie Database (TMDB), to import details, artwork and episodes
# of titles in the admin panel. Take the "API Read Access Token" (or the
# shorter "API Key") from https://www.themoviedb.org/settings/api.
# Empty turns the import off. TMDB is free for sites that earn no money; a
# site that sells access needs an agreement with TMDB.
TMDB_API_TOKEN=
# Language details are imported in when the admin does not choose one.
METADATA_LANGUAGE=en-US
# Country whose age ratings are imported.
METADATA_REGION=US

# Watched folders. How long a file must have been left alone before it is
# imported, in seconds. Raise it when files are copied in slowly and in pauses.
WATCH_SETTLE_SECONDS=60

# Viewing statistics. The panel shows what is watched, how long and by how
# many. For that, each play is recorded with the title, the kind of device and
# how long it played. No address and no description of the device is stored.
# "off" records nothing.
VIEWING_STATISTICS=on
# Days a record of a play is kept. 0 keeps them for good.
VIEWING_STATISTICS_DAYS=730

# Playback quality. Players report how playback went: how long a video took
# to start, how often it stopped to load, in what quality it played and what
# failed. The panel shows it under "Playback quality". A report names the
# video and the kind of device, never a viewer or an address.
# "off" records nothing.
PLAYBACK_REPORTS=on
# Days a report is kept. 0 keeps them for good.
PLAYBACK_REPORTS_DAYS=90

# Notifications. Browsers are reached without any setup, apps through a
# Firebase project you set up in the panel. Push services want to know how to
# reach whoever sends: "mailto:you@your-domain" or an https address. Empty:
# SITE_URL is used when it is https.
PUSH_CONTACT=
# More hosts notifications may be sent to, separated by commas. Leave empty.
PUSH_SERVICE_HOSTS=

# On how many devices one viewer account plays at the same time. 0: no limit.
# A plan can say otherwise, and an admin can for a single viewer.
STREAM_LIMIT=0

# --- Browser access -------------------------------------------------------
# Web origins allowed to call the API from a browser, separated by commas.
# Needed when the admin panel runs on another origin than the API,
# as it does in development. Empty allows same-origin requests only.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 when it is reached directly).
# The Docker Compose setup sets 1 for its Nginx gateway.
TRUST_PROXY_HOPS=0

# Bearer token a monitoring system (Prometheus) sends to read /v1/metrics.
# Empty switches the endpoint off. Generate one with: openssl rand -hex 32
METRICS_TOKEN=

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -hex 32
# Signs admin sessions.
JWT_SECRET=
# Signs playback URLs.
PLAYBACK_SIGNING_SECRET=
# Encrypts content keys and storage credentials at rest.
MASTER_KEY=

# --- Storage --------------------------------------------------------------
# Directory of the default local storage pool, created on first start.
# A relative path is resolved against the folder of this file.
STORAGE_LOCAL_PATH=./storage

# --- Viewer website (apps/web) ---
# Name and sentence about the site. Both are set in the panel under Settings >
# Branding; these are what the website shows when it cannot reach the API.
WEB_SITE_NAME=Onyx Stream
WEB_SITE_DESCRIPTION=Movies and series, streamed to you.
# Public address of the site, used in the sitemap and in link previews.
WEB_SITE_URL=http://localhost:3001
# Where the website's server reaches the API.
WEB_API_URL=http://localhost:3000
# Other addresses video and pictures may come from, such as a CDN in front of
# the storage: https://media.example.com, several separated by spaces or
# commas. Edge servers are added by themselves. Empty allows only the site.
WEB_MEDIA_ORIGIN=
# Where ads may load their video and tracking pictures from, when you play ads
# from an ad server: https://cdn.adserver.example, several separated by spaces
# or commas, or * for any https address, which is what ad networks need as
# their files lie on many hosts. Empty allows none: your own house ads work,
# ads from other hosts are blocked.
WEB_AD_ORIGINS=

# --- Admin panel (apps/admin) ---
# The panel reads its own file in development: see apps/admin/.env.example.

# --- Version ------------------------------------------------------------------
# The diagnostics page of the panel says whether a newer version exists. For
# that the server asks GitHub for the newest commit, at most every six hours,
# and sends nothing about this installation. "off" stops it.
UPDATE_CHECK=on
# Where to ask, for an installation that follows a fork: an address that
# answers with the newest commit as plain text.
#UPDATE_CHECK_URL=
# The commit this installation was built from, when you want the panel to
# compare it. Installations made by the installer have it filled in.
ONYX_COMMIT=
