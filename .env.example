# Copy this file to .env and adjust the values.
# Never commit the .env file.

# --- Database -------------------------------------------------------------
POSTGRES_USER=onyx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onyx
POSTGRES_PORT=5432
DATABASE_URL=postgresql://onyx:change-me@localhost:5432/onyx

# Separate database for end-to-end tests. Tests delete data in it, so it must
# never be the same as DATABASE_URL. Leave empty to skip those tests.
TEST_DATABASE_URL=postgresql://onyx:change-me@localhost:5432/onyx_test

# Optional: an S3-compatible service for the S3 storage driver tests.
# The bucket must already exist. Leave TEST_S3_ENDPOINT empty to skip those tests.
TEST_S3_ENDPOINT=
TEST_S3_REGION=us-east-1
TEST_S3_BUCKET=onyx-test
TEST_S3_ACCESS_KEY_ID=
TEST_S3_SECRET_ACCESS_KEY=

# --- Redis (queue, cache, pub/sub) ----------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ------------------------------------------------------------------
API_PORT=3000
# Role of this process: api | worker | live | scheduler | all
APP_ROLE=all

# --- Uploads --------------------------------------------------------------
# Directory where uploads are collected before they move into a storage pool.
# A relative path is resolved against the folder of this file.
UPLOAD_TEMP_PATH=./uploads
# Largest accepted source file in bytes. The default is 50 GiB.
UPLOAD_MAX_BYTES=53687091200

# --- Processing -----------------------------------------------------------
# Programs used for media processing. A name is looked up on the PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Working directory of processing jobs. It needs room for a source file and
# its outputs. A relative path is resolved against the folder of this file.
PROCESSING_TEMP_PATH=./tmp/processing
# Processing jobs one worker process runs at the same time.
# Transcoding already uses all CPU cores, so 1 is right for most servers.
WORKER_CONCURRENCY=1

# --- Playback -------------------------------------------------------------
# How long a playback URL stays valid, in seconds. The default is six hours.
# Videos longer than that get more time automatically.
PLAYBACK_URL_TTL_SECONDS=21600
# Origin that serves media files, for example https://media.example.com.
# Leave empty while the API serves them itself.
MEDIA_BASE_URL=

# --- Browser access -------------------------------------------------------
# Web origins allowed to call the API from a browser, separated by commas.
# Needed when the admin panel runs on another origin than the API,
# as it does in development. Empty allows same-origin requests only.
CORS_ORIGINS=http://localhost:5173

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -hex 32
# Signs admin sessions.
JWT_SECRET=
# Signs playback URLs.
PLAYBACK_SIGNING_SECRET=
# Encrypts content keys and storage credentials at rest.
MASTER_KEY=

# --- Storage --------------------------------------------------------------
# Directory of the default local storage pool, created on first start.
# A relative path is resolved against the folder of this file.
STORAGE_LOCAL_PATH=./storage
